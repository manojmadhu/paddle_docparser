# Copy to .env (or set in docker-compose) and adjust. All settings are optional.
DOCPARSE_DEVICE=cpu
DOCPARSE_CPU_THREADS=8

# Turn features off you never need (saves memory and startup time)
DOCPARSE_ENABLE_CHARTS=true
DOCPARSE_ENABLE_FORMULAS=true
DOCPARSE_ENABLE_SEALS=false

# Routing thresholds - tune on ~50 of your own documents
DOCPARSE_HANDWRITING_THRESHOLD=0.80
DOCPARSE_HANDWRITING_PAGE_RATIO=0.30
DOCPARSE_MIN_TEXT_LAYER_CHARS=50
DOCPARSE_RENDER_DPI=200
